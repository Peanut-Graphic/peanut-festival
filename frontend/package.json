{
    "name": "peanut-festival-frontend",
    "version": "1.3.2",
    "private": true,
    "type": "module",
    "engines": {
        "node": "22.22.2",
        "npm": "10.9.7"
    },
    "packageManager": "npm@10.9.7",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:a11y": "vitest run -- a11y",
        "test:coverage": "vitest run --coverage",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css}\"",
        "lint:a11y": "eslint src",
        "runtime:verify": "node ../scripts/verify-node-runtime-contract.cjs"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.1.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@tanstack/react-query": "^5.103.2",
        "axios": "^1.20.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "dompurify": "^3.4.15",
        "lucide-react": "^0.468.0",
        "react": "^19.3.0",
        "react-big-calendar": "^1.15.0",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.88.0",
        "react-router-dom": "^7.18.4",
        "zustand": "^5.0.1"
    },
    "browserslist": [
        "last 2 Chrome versions",
        "last 2 Firefox versions",
        "last 2 Safari versions",
        "last 2 Edge versions",
        "not dead"
    ],
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/dompurify": "^3.2.0",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-big-calendar": "^1.8.12",
        "@types/react-dom": "^18.3.1",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^4.1.1",
        "autoprefixer": "^10.6.1",
        "axe-core": "^4.8.3",
        "eslint": "^9.39.4",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "jest-axe": "^9.0.0",
        "jsdom": "^25.0.1",
        "postcss": "^8.5.28",
        "prettier": "^3.9.8",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^3.4.14",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.0",
        "vitest": "^4.1.1"
    },
    "overrides": {
        "nanoid": "^3.3.18"
    }
}
